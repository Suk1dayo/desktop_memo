# 默认按文本处理，仓库内统一 LF
* text=auto

# Windows 脚本必须是 CRLF，否则 cmd 解析 may fail
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# 源码与文档统一 LF
*.cs   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.json text eol=lf diff=json

# 二进制
*.exe  binary
*.ico  binary
*.png  binary
*.dll  binary
